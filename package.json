{
  "name": "@creait/dsh-provider-web-search",
  "version": "0.2.0",
  "description": "DSH Native Search: strict, single-request hosted web search for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luhcow/dsh-native-search.git"
  },
  "homepage": "https://github.com/luhcow/dsh-native-search#readme",
  "bugs": {
    "url": "https://github.com/luhcow/dsh-native-search/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-web": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2"
  },
  "license": "MIT",
  "keywords": ["dsh", "web-search", "openai-responses", "anthropic", "gemini", "hosted-search"]
}
